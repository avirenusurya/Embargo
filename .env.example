# Everything is optional for local development: with no values set, Embargo runs with embedded Postgres
# (PGlite + pgvector in ./data), local key provider, heuristic AI, and off-chain signed records.

# Core
PORT=8787
API_URL=http://localhost:8787
APP_URL=http://localhost:8787
# DATABASE_URL=postgres://user:pass@host:5432/embargo     # managed Postgres 16 with pgvector (Neon/Supabase)
# NODE_ENV=production                                      # disables dev login; requires all secrets below
# EMBARGO_ROLE=all                                         # all | api | worker
# SESSION_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Embargo
WEBAUTHN_ORIGIN=http://localhost:8787
# EMAIL_PROVIDER_API_KEY=                                  # Resend API key for magic links
# EMAIL_FROM=Embargo <noreply@yourdomain>

# Object storage (S3-compatible; local disk if unset)
# OBJECT_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# OBJECT_STORAGE_BUCKET=embargo
# OBJECT_STORAGE_KEY=
# OBJECT_STORAGE_SECRET=

# Keys
KEY_PROVIDER=local
# LOCAL_MASTER_KEY=                                        # base64 of 32 bytes (openssl rand -base64 32)
# KMS_KEY_ID=  KMS_REGION=  AWS_ACCESS_KEY_ID=  AWS_SECRET_ACCESS_KEY=
# RECORD_HMAC_GLOBAL_KEY=

# AI (AI Grants India credits: OpenAI, or NVIDIA NIM via LLM_BASE_URL)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# MODEL_COMPRESS=gpt-4.1-mini  MODEL_CLASSIFY=gpt-4.1-mini  MODEL_JUDGE=gpt-4.1-mini  MODEL_SEALED=gpt-4.1-mini
# MODEL_EMBED=text-embedding-3-small  EMBED_DIM=1536  TRANSCRIBE_MODEL=whisper-1
# AI_MODE=auto                                             # auto | llm | heuristic
# PROMPT_COMPRESS_BLOCK=v1                                 # pin a prompt version per task (prompts/<task>.vN.md); default = highest
# FFMPEG_PATH=ffmpeg                                       # used to split uploaded audio/video for Whisper
# WHISPER_CHUNK_SECONDS=600  WHISPER_MAX_BYTES=25165824    # segment length; max upload size when ffmpeg is unavailable

# Integrations
# WISPR_MCP_URL=                                           # Wispr Notetaker remote MCP URL
# WISPR_OAUTH_CLIENT_ID=                                   # only if Wispr does not support dynamic client registration
# GITHUB_APP_ID=  GITHUB_APP_PRIVATE_KEY=  GITHUB_WEBHOOK_SECRET=
# VIASOCKET_DEFAULT_SECRET=
# TIGERGRAPH_HOST=https://<id>.i.tgcloud.io  TIGERGRAPH_GRAPH=Embargo  TIGERGRAPH_TOKEN=
# DODO_API_KEY=  DODO_WEBHOOK_SECRET=  DODO_PRODUCT_TEAM=  DODO_BASE_URL=https://test.dodopayments.com

# Chain (Base Sepolia for development; Base mainnet 8453 for production)
CHAIN_ID=84532
# RPC_URL=https://sepolia.base.org
# EAS_CONTRACT_ADDRESS=0x4200000000000000000000000000000000000021
# EAS_SCHEMA_REGISTRY_ADDRESS=0x4200000000000000000000000000000000000020
# EAS_SCHEMA_UID=                                          # from: npm run chain:register-schema
# RELAYER_PRIVATE_KEY=0x...
BATCH_INTERVAL_SECONDS=600
BATCH_SIZE=500

# Limits
RATE_LIMIT_MCP_PER_MIN=120
RATE_LIMIT_SEALED_PER_MIN=20
# Rate limits are stored in Postgres (table rate_limits), so they hold across API instances.
# ANOMALY_TOKENS_PER_HOUR=200000   ANOMALY_VOLUME_FACTOR=5   # alert when a connection's hourly tokens exceed both
# ACCESS_LOG_RETENTION_DAYS=180   UPLOAD_LIMIT_BYTES=20971520

# Context compiler (Part 9.3; tune with `npm run eval -- --only retrieval`)
# COMPILER_TOPK=50                 # vector-search candidates per compile (spec 9.3 top_k), plus pinned items
# COMPILER_REL_SIM=0.5             # drop unpinned candidates below this fraction of the best unpinned similarity
# COMPILER_MIN_SIM=0.05            # ... and below this absolute similarity (pinned items are always kept)
# COMPILER_DEDUPE=0.92  CLUSTER_JOIN=0.8
# W_SIM=0.55  W_PIN=0.15  W_RECENCY=0.1  W_PRIOR=0.2  W_STALE=0.1  W_CONFLICT=0.05   # score weights

# Context manager
# AUTO_APPLY_THRESHOLD=0.85        # default for workspaces without settings.auto_apply_threshold (0.5–1.0)
# INBOX_REMINDER_HOURS=72          # remind context admins about inbox items older than this

# Operations
# METRICS_TOKEN=                   # if set, GET /metrics requires Authorization: Bearer <token>
# ADMIN_TOKEN=                     # enables GET /admin/analytics (Bearer); 404 when unset
