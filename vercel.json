{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev --ignore-scripts --no-audit --no-fund",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "vercel-public",
  "rewrites": [
    { "source": "/(.*)", "destination": "https://embargoai.onrender.com/$1" }
  ]
}
